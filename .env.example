# Copy this file to .env and fill in real values. .env is gitignored.

# --- LLM Provider ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5
LLM_FAST_MODEL=claude-haiku-4-5

# --- LLM Provider (local, used by injection_service) ---
# Points at an Ollama server running on the host; host.docker.internal lets the
# container reach it on Windows/Mac without extra network config.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4

# --- Embeddings ---
# provider=local runs sentence-transformers on-box, free, no API key needed.
# Switching model/provider changes the embedding dimension (this one is 384) -
# the Pinecone index must be recreated to match, see README.
# Set EMBEDDING_PROVIDER=openai + EMBEDDING_MODEL=text-embedding-3-small (1536-dim)
# to go back to OpenAI embeddings.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=

# --- Vector DB (Pinecone) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=enterprise-knowledge

# --- Observability (LangSmith) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-ai-assistant

# --- Auth ---
JWT_SECRET_KEY=change-me-in-local-env
JWT_EXPIRY_MINUTES=60

# --- Rate Limiting (token bucket) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SEC=0.5

# --- App / Networking ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_BASE_URL=http://backend:8000
LOG_LEVEL=INFO

# --- MCP Server ---
MCP_SERVER_URL=http://mcp_server:9000
